<script>
// Confeti multicolor al tocar "Empezar gratis"
const confettiCanvas = document.getElementById("confetti-canvas");
function launchConfetti() {
  if (!confettiCanvas) return;
  const ctx = confettiCanvas.getContext("2d");
  confettiCanvas.width = window.innerWidth;
  confettiCanvas.height = window.innerHeight;
  const pieces = [];
  const colors = ['#2563EB', '#38BDF8', '#10B981', '#F43F5E', '#F59E0B', '#A855F7', '#FFFFFF'];
  for (let i = 0; i < 90; i++) {
    pieces.push({
      x: window.innerWidth / 2,
      y: window.innerHeight / 2,
      w: Math.random() * 8 + 4,
      h: Math.random() * 6 + 4,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 16,
      vy: (Math.random() - 0.7) * 16,
      gravity: 0.35,
      rotation: Math.random() * 360,
      vRot: (Math.random() - 0.5) * 12,
      opacity: 1
    });
  }
  let frames = 0;
  function render() {
    ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
    pieces.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      p.vy += p.gravity;
      p.rotation += p.vRot;
      p.opacity -= 0.012;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate((p.rotation * Math.PI) / 180);
      ctx.globalAlpha = Math.max(0, p.opacity);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
      ctx.restore();
    });
    frames++;
    if (frames < 80) requestAnimationFrame(render);
    else ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
  }
  render();
}

// Modal Interaction
const openAuth = document.getElementById("open-auth-btn");
const closeAuth = document.getElementById("close-auth-btn");
const modalBackdrop = document.getElementById("auth-modal-backdrop");
const pocketStart = document.getElementById("btn-pocket-start");

function showAuthModal() {
  if (modalBackdrop) modalBackdrop.style.display = "flex";
}
if (openAuth) {
  openAuth.onclick = () => {
    launchConfetti();
    showAuthModal();
  };
}
if (pocketStart) pocketStart.onclick = showAuthModal;
if (closeAuth && modalBackdrop) closeAuth.onclick = () => modalBackdrop.style.display = "none";
if (modalBackdrop) {
  modalBackdrop.onclick = (e) => {
    if (e.target === modalBackdrop) modalBackdrop.style.display = "none";
  };
}

// Toggle entre Login y Registro en el Modal
const authToggleBtn = document.getElementById("auth-toggle-mode-btn");
const authTitle = document.getElementById("auth-modal-title");
const authSub = document.getElementById("auth-modal-subtitle");
const authQuestion = document.getElementById("auth-toggle-question");
let isRegisterMode = false;

if (authToggleBtn) {
  authToggleBtn.onclick = () => {
    isRegisterMode = !isRegisterMode;
    if (isRegisterMode) {
      authTitle.textContent = "Creá tu cuenta gratis ✨";
      authSub.textContent = "Comenzá a ahorrar en tus facturas hoy mismo";
      authQuestion.textContent = "¿Ya tenés cuenta?";
      authToggleBtn.textContent = "Iniciar sesión";
    } else {
      authTitle.textContent = "Bienvenido/a de vuelta 👋";
      authSub.textContent = "Accedé para ver el estado de tu gestión de ahorro";
      authQuestion.textContent = "¿No tenés una cuenta?";
      authToggleBtn.textContent = "Registrarme";
    }
  };
}

// File Upload Simulation
const btnAnalizar = document.getElementById("btn-analizar-factura");
const quickResult = document.getElementById("quick-analysis-result");
const dropTitle = document.getElementById("drop-status-title");
const dropSub = document.getElementById("drop-status-sub");
const fileInput = document.getElementById("real-file-input");

function handleFileSelection() {
  if (quickResult) quickResult.style.display = "block";
  if (dropTitle) dropTitle.textContent = "factura_seleccionada.pdf";
  if (dropSub) dropSub.textContent = "✓ Factura cargada y lista para gestión";
  quickResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

if (fileInput) fileInput.onchange = handleFileSelection;
if (btnAnalizar) btnAnalizar.onclick = handleFileSelection;

// Mouse follower
const mouseFollower = document.getElementById("mouse-follower");
if (mouseFollower) {
  window.addEventListener("mousemove", (e) => {
    mouseFollower.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
  });
}
</script>
<script id="interactive-nav-handlers">
(function() {
  function highlightElement(el, isCard) {
    if (!el) return;
    const cls = isCard ? 'card-pulse-target' : 'nav-highlight-target';
    el.classList.remove(cls);
    void el.offsetWidth;
    el.classList.add(cls);
    setTimeout(() => el.classList.remove(cls), 2000);
  }

  // 1. Cómo funciona: scroll a #como y resalta los 3 pasos
  const btnComo = document.getElementById('nav-btn-como');
  if (btnComo) {
    btnComo.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('como');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.querySelectorAll('.step-card').forEach((step, idx) => {
          setTimeout(() => highlightElement(step, true), idx * 120);
        });
      }
    });
  }

  // 2. Servicios: scroll a #servicios y resalta la tarjeta de desglose
  const btnServicios = document.getElementById('nav-btn-servicios');
  if (btnServicios) {
    btnServicios.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('servicios');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const card = document.querySelector('.breakdown-card');
        setTimeout(() => highlightElement(card, true), 300);
      }
    });
  }

  // 3. Proveedores: scroll a #proveedores y destaca el carrusel
  const btnProveedores = document.getElementById('nav-btn-proveedores');
  if (btnProveedores) {
    btnProveedores.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('proveedores');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const marquee = document.querySelector('.marquee-container');
        setTimeout(() => highlightElement(marquee, false), 300);
      }
    });
  }

  // 4. Preguntas: scroll a #faq y abre la primera pregunta con destello
  const btnFaq = document.getElementById('nav-btn-faq');
  if (btnFaq) {
    btnFaq.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('faq');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const firstDetail = document.querySelector('.faq-wrap details');
        if (firstDetail) {
          firstDetail.open = true;
          setTimeout(() => highlightElement(firstDetail, false), 350);
        }
      }
    });
  }

  // 5. Botones Hero: 'Subir mi factura ahora' y 'Ver cómo funciona'
  const heroBtnSubir = document.querySelector('.hero-actions a[href="#subir"]');
  if (heroBtnSubir) {
    heroBtnSubir.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('subir');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const uploadCard = document.getElementById('invoice-upload-card');
        setTimeout(() => highlightElement(uploadCard, true), 300);
      }
    });
  }

  const heroBtnComo = document.querySelector('.hero-actions a[href="#como"]');
  if (heroBtnComo) {
    heroBtnComo.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('como');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        document.querySelectorAll('.step-card').forEach((step, idx) => {
          setTimeout(() => highlightElement(step, true), idx * 120);
        });
      }
    });
  }

  // 6. Botón 'Quiero este ahorro ya →' dentro de la calculadora dispara confeti y abre modal
  const pocketStart = document.getElementById('btn-pocket-start');
  if (pocketStart) {
    pocketStart.addEventListener('click', function() {
      if (typeof launchConfetti === 'function') launchConfetti();
      if (typeof showAuthModal === 'function') showAuthModal();
    });
  }

  // 7. Botón 'Subir mi factura gratis' en banner inferior
  const ctaBottomBtn = document.querySelector('.cta-banner a[href="#subir"]');
  if (ctaBottomBtn) {
    ctaBottomBtn.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.getElementById('subir');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const uploadCard = document.getElementById('invoice-upload-card');
        setTimeout(() => highlightElement(uploadCard, true), 300);
      }
    });
  }
})();
